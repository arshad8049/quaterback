        "id": "AC-1",
        "criterion": "isWarning(createWarning({...})) === true and isWarning(createDeprecation({...})) === true"
      },
      {
        "id": "AC-2",
        "criterion": "isWarning returns false for plain functions, objects that mimic a warning's properties, null and undefined"
      },
      {
        "id": "AC-3",
